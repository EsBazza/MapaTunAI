# Copy to .env and fill in. Never commit real values.

# Database (Supabase Postgres)
DATABASE_URL=          # transaction pooler connection string
DIRECT_URL=            # direct connection string (used by Prisma migrations)

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# AI (Google Gemini)
GEMINI_API_KEY=

# Photo uploads (Supabase Storage, bucket "review-photos")
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMS verification (Semaphore)
SEMAPHORE_API_KEY=

# PSA PSGC API
PSA_PSGC_TOKEN=

# Secrets
JWT_SECRET=
CRON_SECRET=           # Bearer token for /api/cron/sync, /api/seed, /api/psgc/populate

# Local testing only: "true" lets +639000000000 skip real SMS. Must be false in production.
DEMO_OTP_BYPASS=false
